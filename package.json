{
  "name": "merkabot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram VPN shop bot for 3x-ui v3.1",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ./node_modules/typescript/bin/tsc -w -p tsconfig.json",
    "dev:web": "vite --config web/vite.config.ts",
